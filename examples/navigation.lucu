-- Luca UI 0.6 Alpha example: component-based navigation and accessibility.
-- Assumption syntax (see docs/implementation-status.md); component and entry
-- names here are placeholders, NOT the locked vocabulary. Screens are
-- components addressed by `id` — there are no routes in this model.
App:
  id = "app"
  Home:
    id = "home"
    label = "Home screen"
    Text:
      id = "welcome"
      text = "Welcome"
    Button:
      id = "open"
      text = "Open details"
      events:
        tap = show_detail
  Detail:
    id = "detail"
    Text:
      id = "body"
      text = "Details here"
    Button:
      id = "back"
      label = "Go back"
      text = "Back"
      events:
        tap = show_home

-- Luca UI 1.0.2 Beta example: declarations, identity, and tree structure.
-- Assumption syntax (may change; see docs/language.md); component names are
-- placeholders, not the locked standard library.
App:
  id = "app"
  visible = true
  Header:
    id = "header"
    visible = true
    Text:
      id = "title"
      text = "Luca UI"
  Body:
    id = "body"
    disabled = false
    Text:
      id = "greeting"
      text = "Hello, Luca!"
      visible = true

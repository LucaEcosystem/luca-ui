-- Luca UI 1.0.2 Beta example: platform-independent layout and styling.
-- Assumption syntax (may change; see docs/language.md); block and entry
-- names here are placeholders, NOT the locked vocabulary. Entry names carry
-- no locked meaning, and no dimensions, defaults, or precedence are defined.
App:
  id = "app"
  visible = true
  layout:
    gap = 2
    direction = "column"
  style:
    tone = "soft"
  Header:
    id = "header"
    style:
      emphasis = true
    Text:
      id = "title"
      text = "Luca UI"
  Body:
    id = "body"
    disabled = false
    layout:
    Text:
      id = "greeting"
      text = "Hello, Luca!"
      visible = true

-- Luca UI 1.0.2 Beta example: platform-independent layout and styling.
-- The block syntax is an assumption (may change; see docs/language.md). The
-- visual pipeline interprets a documented ◐ subset: here `gap`/`direction`
-- have visual meaning, while `tone`/`emphasis` stay opaque tokens. See
-- docs/styling-theming.md and docs/rendering.md.
App:
  id = "app"
  visible = true
  layout:
    gap = 2
    direction = "column"
  style:
    tone = "soft"
  Header:
    id = "header"
    style:
      emphasis = true
    Text:
      id = "title"
      text = "Luca UI"
  Body:
    id = "body"
    disabled = false
    layout:
    Text:
      id = "greeting"
      text = "Hello, Luca!"
      visible = true
